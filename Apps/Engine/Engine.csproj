	<ItemGroup Condition="'$(IsWindows)' == 'true'">
		<Content Include="..\..\..\SeasonAIs\cudacudnn-runtime\win-x64\native\*.dll">
			<Link>%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<Visible>false</Visible>
		</Content>
	</ItemGroup>

	<ItemGroup Condition="'$(IsWindows)' == 'true' or '$(IsLinux)' == 'true'">
		<Content Include="Resources\Raw\**" CopyToOutputDirectory="PreserveNewest" Link="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<Target Name="IncludeLinuxFilesForLinuxTarget" BeforeTargets="BeforeCompile" Condition="'$(IsLinux)' == 'true'">
		<ItemGroup>
			<Compile Include="Platforms\Linux\**\*.cs" />
		</ItemGroup>
	</Target>

	<Target Name="ExcludeLinuxFilesForNonLinuxTargets" AfterTargets="BeforeCompile" Condition="'$(IsLinux)' != 'true'">
		<ItemGroup>
			<Compile Remove="Platforms\Linux\**\*.cs" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<Content Update="Resources\Raw\Assets\NotoSansMono-VariableFont.ttf" Link="Assets\NotoSansMono-VariableFont.ttf" />
