<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <!-- See https://aka.ms/maui-publish-app-store#add-entitlements for more information about adding entitlements.-->
    <dict>
        <!-- App Sandbox must be enabled to distribute a MacCatalyst app through the Mac App Store. -->
        <key>com.apple.security.app-sandbox</key>
        <true/>
        <!-- When App Sandbox is enabled, this value is required to open outgoing network connections. -->
        <key>com.apple.security.network.client</key>
        <true/>
        <!-- Required for microphone recording under App Sandbox. -->
        <key>com.apple.security.device.audio-input</key>
        <true/>
        <!-- App Sandbox also requires this value to write into the user's real ~/Downloads
             folder (the container's Data/Downloads symlink resolves there). -->
        <key>com.apple.security.files.downloads.read-write</key>
        <true/>
        <!-- Required for UIDocumentPickerViewController. MacCatalyst hands the picker over to the AppKit
             open panel service, and under App Sandbox that service refuses to display the panel without
             this entitlement: AppKit only logs "Unable to display open panel" while UIKit keeps an
             invisible modal that swallows the window's input. read-write (not read-only) because the same
             service also backs the Export to service picker used by SaveFile. -->
        <key>com.apple.security.files.user-selected.read-write</key>
        <true/>
    </dict>
</plist>

